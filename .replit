modules = ["nodejs-20", "python-3.12", "web", "postgresql-16"]
run = "bash -c \"cd server_py && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000\""
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist", "server_py/.venv"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd server_py && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000 --proxy-headers --forwarded-allow-ips='*'"]
build = ["bash", "-c", "npx vite build && pip install -r server_py/requirements.txt"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server_py && python -m uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[agent]
integrations = ["javascript_openai:1.0.0", "javascript_database:1.0.0", "javascript_openai_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0", "javascript_object_storage:2.0.0"]

[userenv]

[userenv.shared]
GHL_LOCATION_ID = "vNsR6W7J8sDcZ2ZGS1sb"

[objectStorage]
defaultBucketID = "replit-objstore-8f5908c9-60c4-4e3a-a03c-7c468a63f47d"
